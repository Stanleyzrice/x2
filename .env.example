# x2 读的环境变量：只有名字和一句说明，值写在仓库根的 .env（不进 git）。代码里新读一个，就在这里加一行（test/architecture.test.ts 守着）

# Vite 构建时将组件库内的此标记固定为 production；正常运行无需设置
NODE_ENV=

# 本项目使用本地 PostgreSQL（关系数据库）：postgres://<本地库账号>:<密码>@127.0.0.1:55432/x2；持久数据在 ../.x2-local/pgdata
X2_DATABASE_URL=
# 本地库直接连接，此项明确留空；不启用旧 SSH（安全远程连接）数据库隧道
X2_DATABASE_SSH=
# 连着几个浏览器时固定用哪一个（booey 里的 id 或名字）；不设就按登录选
X2_BROWSER=
# 本项目设为 ../.x2-local/state，存放锁和知虾用量记录；代码未设置时默认 ~/x2
X2_HOME=
# 首次设置选择的默认 Shopee 店铺账号名
X2_DEFAULT_SHOP=
# 已在本机完成首次设置
X2_SETUP_COMPLETE=
# 做商品稿时同时问 Gemini 几个（默认 8）
X2_GEMINI_CONCURRENCY=
# 做商品稿时同时取几张图（默认 6）
X2_DOWNLOAD_CONCURRENCY=

# Gemini 的 key（看图、文字检查）
GEMINI_API_KEY=
# 换 Gemini 的模型；不设用代码里的默认
GEMINI_MODEL=
# 换 Gemini 的出口网关（地域被挡时）
GEMINI_BASE=

# 象寄（图片译字）的 UserKey
XIANGJI_USER_KEY=
# 象寄的 ImgTransKey
XIANGJI_IMG_TRANS_KEY=
# 换象寄的接口地址（要 https）
XIANGJI_BASE=
# 象寄的翻译引擎（EngineType）；不设用象寄的默认
XIANGJI_ENGINE_TYPE=

# 知虾镜像（市场数据的库）的地址
MARKET_URL=
# 知虾镜像的密钥（Bearer）
MARKET_SECRET=

# Shopee Open API（经香港网关）的 partner id
SHOPEE_PARTNER_ID=
# Shopee Open API 的 partner key
SHOPEE_PARTNER_KEY=

# Chat 的 OpenAI Chat Completions 兼容 Base URL（含服务商要求的 API 路径前缀）
X2_CHAT_BASE_URL=
# Chat 模型服务商的 API Key（接口密钥）
X2_CHAT_API_KEY=
# Chat 模型服务商提供的 Model ID（模型名）
X2_CHAT_MODEL=

# Hermes Agent 使用的 DeepSeek 官方 API Key
DEEPSEEK_API_KEY=
# 已安装 Hermes Agent 的 Python 路径，默认使用 X2 本机运行目录
X2_HERMES_PYTHON=
# Hermes 的 DeepSeek 模型名，默认 deepseek-flash
X2_HERMES_MODEL=
