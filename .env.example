# x2 读的环境变量：只有名字和一句说明，值写在仓库根的 .env（不进 git）。代码里新读一个，就在这里加一行（test/architecture.test.ts 守着）

# 库（Postgres）的地址：共享库是 postgres://<你的库账号>:<密码>@127.0.0.1:15432/x2（账号找管服务器的人要，ops/db-user.sh 建）
X2_DATABASE_URL=
# 连库前开的 SSH 隧道：ops/ssh_config 里的 Host，共享库写 x2-db；连本机的库不设
X2_DATABASE_SSH=
# 连着几个浏览器时固定用哪一个（booey 里的 id 或名字）；不设就按登录选
X2_BROWSER=
# x2 放锁、知虾用量记录的目录；不设是 ~/x2
X2_HOME=
# 做商品稿时同时问 Gemini 几个（默认 8）
X2_GEMINI_CONCURRENCY=
# 做商品稿时同时取几张图（默认 6）
X2_DOWNLOAD_CONCURRENCY=

# Gemini 的 key（看图、文字检查）
GEMINI_API_KEY=
# 换 Gemini 的模型；不设用代码里的默认
GEMINI_MODEL=
# 换 Gemini 的出口网关（地域被挡时）
GEMINI_BASE=

# 象寄（图片译字）的 UserKey
XIANGJI_USER_KEY=
# 象寄的 ImgTransKey
XIANGJI_IMG_TRANS_KEY=
# 换象寄的接口地址（要 https）
XIANGJI_BASE=
# 象寄的翻译引擎（EngineType）；不设用象寄的默认
XIANGJI_ENGINE_TYPE=

# 知虾镜像（市场数据的库）的地址
MARKET_URL=
# 知虾镜像的密钥（Bearer）
MARKET_SECRET=

# Shopee Open API（经香港网关）的 partner id
SHOPEE_PARTNER_ID=
# Shopee Open API 的 partner key
SHOPEE_PARTNER_KEY=
