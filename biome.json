{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!platform/ui/components/ui"]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 160
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["platform/cli.ts", "connectors/sites/*/live.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": {
							"level": "error",
							"options": { "allow": ["error", "log"] }
						}
					}
				}
			}
		},
		{
			"includes": ["tools/**/*.ts", "!tools/**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"fetch": "业务工具通过 Connector 请求外部服务。",
									"XMLHttpRequest": "业务工具通过 Connector 请求外部服务。",
									"WebSocket": "业务工具通过 Connector 请求外部服务。",
									"EventSource": "业务工具通过 Connector 请求外部服务。",
									"globalThis": "业务工具使用显式模块依赖。",
									"global": "业务工具使用显式模块依赖。"
								}
							}
						},
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"node:child_process": "业务工具通过已装配的连接器使用外部进程。",
									"node:module": "业务工具使用可由类型和架构检查识别的导入。",
									"node:http": "业务工具通过 Connector 请求外部服务。",
									"node:https": "业务工具通过 Connector 请求外部服务。",
									"node:http2": "业务工具通过 Connector 请求外部服务。",
									"node:net": "业务工具通过 Connector 建立外部连接。",
									"node:tls": "业务工具通过 Connector 建立外部连接。",
									"node:dgram": "业务工具通过 Connector 建立外部连接。"
								}
							}
						}
					}
				}
			}
		}
	],
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error",
				"useExhaustiveDependencies": "error"
			},
			"style": {
				"noCommonJs": "error",
				"noNonNullAssertion": "off",
				"useImportType": "error",
				"useExportType": "error",
				"useNodejsImportProtocol": "error",
				"useConst": "error",
				"useTemplate": "error",
				"noParameterAssign": "error",
				"useBlockStatements": "off"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImportCycles": "error",
				"noTsIgnore": "error",
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["error"]
					}
				}
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"useExhaustiveSwitchCases": {
					"level": "error",
					"options": {
						"requireExplicitCase": true
					}
				}
			}
		}
	}
}
