{
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024", "dom", "dom.iterable"],
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true,
		"noFallthroughCasesInSwitch": true,
		"types": ["node", "vite/client"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": ["."],
	"exclude": ["dist"]
}
